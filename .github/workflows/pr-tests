name: PR Tests

# Dispara apenas em Pull Requests abertos ou sincronizados, em qualquer branch de destino
on:
  pull_request:
    types: [opened, synchronize]

permissions:
  contents: read

jobs:
  tests:
    name: 🧪 Run Tests
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run pytest
        run: pytest -q
